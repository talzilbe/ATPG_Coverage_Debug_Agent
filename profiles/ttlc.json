{
  "name": "ttlc",
  "display_name": "TTLC",
  "description": "Tessent Visualizer for TTLC, entered through the Cheetah project setup (cth_psetup). Ready to launch as shipped; to target another project copy this file, change the name, and adjust the setup wrapper, -proj/-cfg, licence server and tool path. Profiles are data: adding a project is adding a file, never a code change. Point $ATPG_TOOL_PROFILES at your own directory, or use 'Load profile…' in the GUI, to keep site profiles outside this repository.",
  "shell": "/bin/tcsh",
  "psetup": {
    "executable": "/nfs/site/proj/hdk/pu_tu/prd/liteinfra/1.15.SP1.p02/commonFlow/bin/cth_psetup",
    "proj": "ttlcdie/TS2026.6_TTLC.HF",
    "cfg": "ttlc78a0.cth",
    "proj_flag": "-proj",
    "cfg_flag": "-cfg",
    "ward_flag": "-ward",
    "command_flag": "-x",
    "extra_args": []
  },
  "environment": {
    "SALT_LICENSE_SERVER": "1717@mentor14p.elic.intel.com:1717@mentor06p.elic.intel.com:1717@mentor37p.elic.intel.com:1717@mentor47p.elic.intel.com:1717@siemens12p.elic.intel.com"
  },
  "tool": {
    "executable": "/p/hdk/cad/tessent/2026.1/bin/tessent",
    "shell_flag": "-shell",
    "dofile_flag": "-dofile",
    "logfile_flag": "-logfile",
    "replace_flag": "-replace",
    "extra_args": []
  },
  "commands": {
    "context": "set_context pattern -scan",
    "load": [
      {
        "key": "icl",
        "command": "read_icl",
        "label": "ICL file",
        "switches": [],
        "required": true,
        "run_dir_glob": "tsdb_outdir/dft_inserted_designs/*.dft_inserted_design/*.icl"
      },
      {
        "key": "flat_model",
        "command": "read_flat_model",
        "label": "Flat model",
        "switches": ["-en", "on"],
        "required": true,
        "run_dir_glob": "tsdb_outdir/logic_test_cores/*.logic_test_core/*.atpg_mode_internal/*_internal.flat.gz"
      },
      {
        "key": "faults",
        "command": "read_faults",
        "label": "Fault list",
        "switches": ["-retain"],
        "required": true,
        "run_dir_glob": "faultlist/*.faults.gz"
      }
    ],
    "open": "open_visualizer",
    "fault_inspect": [
      "analyze_fault {fault} -stuck_at {stuck}"
    ],
    "signal_inspect": [
      {
        "verb": "add_schematic_objects",
        "label": "Show in the flat schematic",
        "options": {"-display": "flat_schematic", "-highlight": "red"}
      },
      {
        "verb": "add_schematic_objects",
        "label": "Show in the hierarchical schematic",
        "options": {"-display": "hierarchical_schematic", "-highlight": "red"}
      }
    ]
  },
  "control": {
    "enabled": true,
    "allowed_commands": [
      "add_schematic_objects",
      "add_schematic_path",
      "add_schematic_connections",
      "add_schematic_callout",
      "delete_schematic_objects",
      "open_visualizer"
    ],
    "allowed_options": [
      "-display",
      "-highlight",
      "-direction",
      "-distance_limit",
      "-connections_limit"
    ]
  },
  "terminal_preference": ["xterm", "gnome-terminal", "xfce4-terminal"]
}
