# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Editor / local history
.history
.history/
.vscode/

# Generated analysis outputs
report.csv
report.md

# Bundled GitHub Copilot CLI binary (large) + local auth/session state
tools/
copilot-home/
.copilot/

# Vendored copy of the internal autobots agent tree (see .autobots_manifest.json).
# Not ours to publish, and overwritten on every reinstall.
SageAGENT/

# Site-specific launch profiles. These carry real project names, tool paths and
# licence servers, so only the sanitised template is published. Copy
# profiles/example.json to add your own, or point $ATPG_TOOL_PROFILES elsewhere.
profiles/*.json
!profiles/example.json

# Scratch workareas left behind by the vendor-tool setup wrapper.
TTLC_test/
*_wa/
.cth_setup_files/

# Stray capture from a mistyped redirect (a multi-megabyte PostScript dump).
/os

# OS / misc
.DS_Store
Thumbs.db
