# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Editor / local history
.history
.history/
.vscode/

# Generated analysis outputs
report.csv
report.md

# Bundled GitHub Copilot CLI binary (large) + local auth/session state
tools/
copilot-home/
.copilot/

# Vendored copy of the internal autobots agent tree (see .autobots_manifest.json).
# Not ours to publish, and overwritten on every reinstall.
SageAGENT/

# Launch profiles. The TTLC profile is published so a fresh clone can launch
# the viewer with only small adjustments; any other profile added here stays
# local. Prefer $ATPG_TOOL_PROFILES or the GUI's "Load profile…" (which copies
# into ~/.atpg_debug_agent/profiles) for site profiles you do not want here.
profiles/*.json
!profiles/ttlc.json

# Scratch workareas left behind by the vendor-tool setup wrapper.
TTLC_test/
*_wa/
.cth_setup_files/

# Stray capture from a mistyped redirect (a multi-megabyte PostScript dump).
/os

# OS / misc
.DS_Store
Thumbs.db
